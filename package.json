{
  "name": "forge-ai",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "turbo run build",
    "demo": "node scripts/demo.mjs",
    "dev": "turbo run dev --parallel",
    "generate:types": "pnpm --filter @forge/api openapi:export && pnpm --filter @forge/shared-types generate:openapi",
    "lint": "turbo run lint",
    "postinstall": "node scripts/setup-python.mjs",
    "test": "turbo run test",
    "test:security": "turbo run test:security",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @forge/api db:migrate",
    "db:seed": "pnpm --filter @forge/api db:seed",
    "demo:agentic": "pnpm --filter @forge/api demo:agentic",
    "demo:evaluations": "pnpm --filter @forge/api demo:evaluations",
    "demo:langgraph": "pnpm --filter @forge/api demo:langgraph",
    "demo:planning": "pnpm --filter @forge/api demo:planning",
    "demo:approvals": "pnpm --filter @forge/api demo:approvals",
    "demo:tools": "pnpm --filter @forge/api demo:tools"
  },
  "devDependencies": {
    "turbo": "2.6.1"
  }
}
