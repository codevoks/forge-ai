{
  "name": "@forge/api",
  "private": true,
  "scripts": {
    "build": "../../.venv/bin/python -m compileall src tests",
    "demo:agentic": "../../.venv/bin/python -m forge_api.scripts.demo_agentic",
    "demo:evaluations": "../../.venv/bin/python -m forge_api.scripts.demo_evaluations",
    "demo:debugger": "../../.venv/bin/python -m forge_api.scripts.demo_debugger",
    "demo:langgraph": "../../.venv/bin/python -m forge_api.scripts.demo_langgraph",
    "demo:planning": "../../.venv/bin/python -m forge_api.scripts.demo_planning",
    "demo:approvals": "../../.venv/bin/python -m forge_api.scripts.demo_approvals",
    "demo:recovery": "../../.venv/bin/python -m forge_api.scripts.demo_recovery",
    "demo:tools": "../../.venv/bin/python -m forge_api.scripts.demo_tools",
    "db:migrate": "../../.venv/bin/python -m forge_api.scripts.migrate",
    "db:seed": "../../.venv/bin/python -m forge_api.scripts.seed",
    "dev": "../../.venv/bin/uvicorn forge_api.main:create_app --factory --host 127.0.0.1 --port 8000 --reload",
    "lint": "../../.venv/bin/ruff check src tests && ../../.venv/bin/mypy src",
    "openapi:export": "../../.venv/bin/python -m forge_api.scripts.export_openapi",
    "test": "../../.venv/bin/pytest tests -m 'not security'",
    "test:security": "../../.venv/bin/pytest tests -m security",
    "typecheck": "../../.venv/bin/mypy src"
  },
  "devDependencies": {}
}
